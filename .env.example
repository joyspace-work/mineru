# ──────────────────────────────────────────────
# AI Provider (Gemini 优先，免费+稳定)
# ──────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_SOURCE_IMPORT_MODEL=gemini-3.5-flash
GEMINI_EMPTY_RETRIES=2
GEMINI_RAW_OUTPUT_DIR=

# MinerU recognition tuning
MINERU_METHOD=auto
MINERU_BACKEND=pipeline
MINERU_EFFORT=medium
MINERU_LANG=ch
MINERU_TABLE=true
MINERU_FORMULA=true
MINERU_IMAGE_ANALYSIS=false
MINERU_DEBUG=false
MINERU_START_PAGE=
MINERU_END_PAGE=
MINERU_TIMEOUT_SECONDS=300

# OpenRouter 备选
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SOURCE_IMPORT_MODEL=google/gemini-3.5-flash

