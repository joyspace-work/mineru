# Optional: enable AI-assisted vehicle source parsing.
# Copy this file to .env and set your own key locally.

# Option A: OpenRouter.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SOURCE_IMPORT_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Option B: OpenAI. Leave AI_PROVIDER=openai if you use this.
OPENAI_API_KEY=

# Option C: Direct Gemini API (Google AI Studio - Free & Stable)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_SOURCE_IMPORT_MODEL=gemini-2.5-flash

# Optional generic fallback for either provider.
AI_SOURCE_IMPORT_MODEL=
OPENAI_SOURCE_IMPORT_MODEL=gpt-4.1-mini

# Feishu Bitable Configuration
FEISHU_BASE_TOKEN=
FEISHU_VEHICLES_TABLE_ID=
FEISHU_PROFILES_TABLE_ID=
FEISHU_SUPPLIERS_TABLE_ID=
FEISHU_SNAPSHOTS_TABLE_ID=
FEISHU_EXPERIENCES_TABLE_ID=

