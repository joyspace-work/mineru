# ──────────────────────────────────────────────
# OpenAI 兼容统一 API 配置 (OpenAI-Compatible Standard)
# 适用服务: Ollama, OpenRouter, DeepSeek, vLLM, SiliconFlow, Zhipu, OpenAI, 本地部署 等
# ──────────────────────────────────────────────
API_KEY=your_api_key_here
PARSE_MODEL=minimax-m3
BASE_URL=https://ollama.com/v1

# ──────────────────────────────────────────────
# MinerU 最高识别精度模式配置 (Highest Precision Mode)
# ──────────────────────────────────────────────
MINERU_BACKEND=hybrid
MINERU_METHOD=auto
MINERU_LANG=ch
MINERU_EFFORT=high
MINERU_TABLE=true
MINERU_FORMULA=true
MINERU_IMAGE_ANALYSIS=true
MINERU_DEBUG=false
MINERU_TIMEOUT_SECONDS=600
MINERU_CONFIDENCE_THRESHOLD=0.6

# ──────────────────────────────────────────────
# 飞书多维表格配置 (Feishu Bitable Sync)
# ──────────────────────────────────────────────
